# 必填：填写新 Debian 的内网 IP（默认只监听本机，不自动暴露端口）。
BIND_IP=127.0.0.1
WEB_PORT=8086
SYSLOG_PORT=5514
# 必填：随机生成至少 12 位密码；不要提交实际 .env。
APP_PASSWORD=
# 必填：实际发送 syslog 的 ROS 内网 IP，可逗号分隔多个 IP/CIDR。
ALLOWED_SENDERS=
WAN_MAP={"pppoe-out1":"WAN1","pppoe-out2":"WAN2"}
RETENTION_DAYS=7
MAX_DB_MB=512
MAX_ROWS=500000
MIN_FREE_MB=256
INGEST_PER_SECOND=500
# limited=ROS 有限速；unknown=未确认；full=你已确认未限速（UDP仍可能丢失）。
SAMPLING_MODE=limited
# HTTPS 反向代理访问时改为 true；仅 HTTP 时 false。
COOKIE_SECURE=false
